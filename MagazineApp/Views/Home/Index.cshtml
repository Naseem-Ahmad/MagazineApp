@{
    ViewData["Title"] = "Home";
}

<section class="hero-section d-flex align-items-center justify-content-center text-center text-light">
    <div class="overlay"></div>
    <div class="container position-relative z-1">
        <h1 class="display-4 fw-bold mb-3">Welcome 👋</h1>
        <p class="lead mb-4">Learn about building modern Web Apps with <strong>ASP.NET Core (.NET 8)</strong></p>
        <a href="/Home/About" class="btn btn-primary btn-lg rounded-pill shadow">Learn More</a>
    </div>
</section>

<section class="container my-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">Development Notice</h2>
        <p class="text-muted mx-auto" style="max-width: 700px;">
            We are a small team currently focused on <strong>CI/CD</strong> and modern DevOps practices.
            Our goal is to showcase examples using the latest tools and technologies.
            The site’s appearance may not be perfect right now, but it’s built using modern approaches
            so that anyone can learn from these live examples. As we continue development, we’ll soon
            improve the presentation and overall structure.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4">
                    <h3 class="fw-semibold text-primary mb-3 text-center">Technical Stack</h3>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>Frontend:</strong> ASP.NET Core MVC (Razor View)</li>
                        <li class="list-group-item"><strong>Backend:</strong> C# & MS SQL (Database)</li>
                        <li class="list-group-item"><strong>Environment:</strong> .NET 8</li>
                        <li class="list-group-item"><strong>ORM:</strong> Entity Framework Core (Code-First Approach)</li>
                        <li class="list-group-item"><strong>Deploy:</strong> On Render (Free Hosting)</li>
                        <li class="list-group-item"><strong>Hosting:</strong> Docker container (Render doesn’t provide inbuilt .NET runtime)</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<footer class="text-center py-4 mt-5 border-top">
    <p class="text-muted mb-0 small">Built with ❤️ using ASP.NET Core &amp; .NET 8 — Deployed via Docker on Render</p>
</footer>

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f9fafc;
        color: #333;
    }

    .hero-section {
        position: relative;
        height: 80vh;
        background: url('https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=1950&q=80') center/cover no-repeat;
    }

    .overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 0;
    }

    .btn-primary {
        background-color: #0d6efd;
        border: none;
        padding: 0.75rem 2rem;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background-color: #0b5ed7;
        transform: scale(1.05);
    }

    .card {
        background-color: #fff;
    }

    .list-group-item {
        border: none;
        background-color: #f8f9fa;
        border-radius: 8px;
        margin-bottom: 8px;
        padding: 12px 16px;
    }

    footer {
        background: #fff;
    }


    
</style>

<style>
    @@media (max-width: 768px) {
        .hero-section {
            height: 60vh;
        }
    }
</style>