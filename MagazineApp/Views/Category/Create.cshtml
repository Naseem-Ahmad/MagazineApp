@model Category


    <form method="post">
        <div class="border p-3 mt-4">
            <h2 class="text-primary"> Create Category</h2>
            <hr />

        <div class="mb-3 row pt-1">
            <label class="p-0">Category Name</label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="mb-3 row">
            <label class="p-0">Display Order</label>
            <input type="text" class="form-control" />
        </div>
        <div class="row">
            <div class="col-6 col-md-3">
                <button type="submit" class="btn btn-primary" style="width:150px">Create</button>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Category" asp-action="Index" class="btn btn-secondary" style="width:150px">
                    Back to the List
                </a>
            </div>
        </div>
    </div>
    </form>






@{
}
